{
  "name": "theta-engine",
  "version": "0.5.0",
  "description": "Deterministic schema-driven intake runtime and progressive question engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./dag": {
      "types": "./dist/dag.d.ts",
      "default": "./dist/dag.js"
    },
    "./canonical": {
      "types": "./dist/canonical.d.ts",
      "default": "./dist/canonical.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "default": "./dist/diagnostics.js"
    },
    "./migration": {
      "types": "./dist/migration.d.ts",
      "default": "./dist/migration.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "default": "./dist/history.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "default": "./dist/codegen.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./path": {
      "types": "./dist/path.d.ts",
      "default": "./dist/path.js"
    },
    "./predicates": {
      "types": "./dist/predicates.d.ts",
      "default": "./dist/predicates.js"
    },
    "./scope": {
      "types": "./dist/scope.d.ts",
      "default": "./dist/scope.js"
    },
    "./branches": {
      "types": "./dist/branches.d.ts",
      "default": "./dist/branches.js"
    },
    "./transaction": {
      "types": "./dist/transaction.d.ts",
      "default": "./dist/transaction.js"
    },
    "./projections": {
      "types": "./dist/projections.d.ts",
      "default": "./dist/projections.js"
    },
    "./react": {
      "types": "./dist/batteries/react/index.d.ts",
      "default": "./dist/batteries/react/index.js"
    },
    "./remix": {
      "types": "./dist/batteries/remix/index.d.ts",
      "default": "./dist/batteries/remix/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/INVARIANTS.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:js",
    "clean": "rm -rf dist",
    "build:types": "tsc",
    "build:js": "mkdir -p dist && cp -r src/* dist/",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "prepack": "npm run build",
    "build:playground": "node scripts/bundle-playground.mjs"
  },
  "keywords": [
    "theta",
    "intake-engine",
    "schema-driven",
    "form-engine",
    "declarative-ui",
    "progressive-disclosure",
    "state-machine",
    "legal-tech",
    "zero-dependency",
    "dependency-dag",
    "diagnostics",
    "time-travel",
    "migration",
    "adapters",
    "codegen"
  ],
  "author": "Anmol Maniyar",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
